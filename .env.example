# ==================================
# SmartWord Client Configuration
# ==================================

# --- API URL ---
# Development (локально на компьютере):
EXPO_PUBLIC_API_URL=http://192.168.1.36:3000

# Development (на телефоне через Expo Go):
# Замените IP на ваш локальный IP (узнать: ip addr или ifconfig)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Production:
# EXPO_PUBLIC_API_URL=https://api.smartword.app

# --- Feature Flags (опционально) ---
# Включить отладочные логи
# EXPO_PUBLIC_DEBUG=true

# --- Development Tips ---
# 1. Для локальной разработки: оставьте http://localhost:4000
# 2. Для тестирования на телефоне: укажите IP компьютера
# 3. Убедитесь, что сервер запущен: cd server && npm run dev
# 4. Проверьте, что телефон и компьютер в одной Wi-Fi сети
