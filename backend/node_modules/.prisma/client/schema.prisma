generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  isPremium      Boolean  @default(false)
  aiMessagesUsed Int      @default(0)
  createdAt      DateTime @default(now())

  groups        WordGroup[]
  words         Word[]
  refreshTokens RefreshToken[]
}

model WordGroup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  language  String
  createdAt DateTime @default(now())

  words Word[]
}

model Word {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        WordGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  original     String
  translation  String
  correctCount Int        @default(0)
  lastReviewed DateTime?
  createdAt    DateTime   @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}
