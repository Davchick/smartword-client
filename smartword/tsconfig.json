{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "sourceMap": true,
    "isolatedModules": true
  },
  "include": [
    "./src",
    "App.js",
    "index.js"
  ]
}
