# URL бэкенда (порт из backend/.env, обычно 3000).
# На эмуляторе: http://localhost:3000
# На телефоне (Expo Go): укажите IP вашего ПК в локальной сети, например:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# Узнать IP: Windows — ipconfig, macOS/Linux — ifconfig или ip addr
EXPO_PUBLIC_API_URL=http://localhost:3000
