generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  emailVerified  Boolean        @default(false)
  emailVerifyToken         String?   @unique
  emailVerifyTokenExpiresAt DateTime?
  googleId       String?        @unique
  googleEmail    String?
  googlePicture  String?
  isPremium      Boolean        @default(false)
  aiMessagesUsed Int            @default(0)
  createdAt      DateTime       @default(now())

  // Лимит выученных слов в неделю (50 для бесплатных, безлимит для Premium)
  wordsLearnedThisWeek Int      @default(0)
  weekStartDate        DateTime @db.Date @default("2026-03-02T00:00:00Z")

  // Подписка через ЮKassa (разовые платежи с продлением срока)
  subscriptionType      String?
  subscriptionExpiresAt DateTime?

  groups              WordGroup[]
  words               Word[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  trainingProgress    TrainingProgress[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model WordGroup {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  language   String
  createdAt  DateTime @default(now())

  words      Word[]
}

model Word {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        WordGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  original     String
  translation  String
  correctCount Float     @default(0)
  lastReviewed DateTime?
  createdAt    DateTime  @default(now())
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String    @unique
  deviceFingerprint String? @db.VarChar(64)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  
  @@index([userId, deviceFingerprint])
}

model TrainingProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

