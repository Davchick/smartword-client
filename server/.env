# --- SMTP (отправка писем) ---
# Для РАЗРАБОТКИ можно ничего не заполнять: бэкенд сам поднимет тестовый ящик Ethereal,
# письма не уйдут на реальную почту, но в консоли будет ссылка «Посмотреть» — по ней откроется письмо в браузере.
#
# Для РЕАЛЬНОЙ отправки (продакшен) — бесплатно из РФ:
#   Яндекс: заведи почту @yandex.ru, в настройках включи «Пароли приложений», создай пароль.
#   SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=твой@yandex.ru   SMTP_PASS=пароль_приложения   MAIL_FROM=твой@yandex.ru
#   Mail.ru: аналогично, smtp.mail.ru, порт 465, в настройках почты — пароль для приложений.
#
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=smartword67@mail.ru
