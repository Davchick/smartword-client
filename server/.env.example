DATABASE_URL=postgresql://user:password@localhost:5432/smartword
PORT=4000
JWT_SECRET=change_me_super_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# OpenRouter API ключи — перечисли через запятую (минимум 1, лучше 3-5)
# Каждый ключ с пополнением $10+ даёт 1,000 бесплатных запросов/день
# Пример: 3 ключа = 3,000 бесплатных запросов/день
# Получить ключи: https://openrouter.ai/keys


# Ссылки в письмах (верификация, сброс пароля)
APP_PUBLIC_URL=http://localhost:4000

# --- SMTP (отправка писем) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@smartword.app

# --- Google OAuth (вход через Google) ---
GOOGLE_CLIENT_ID=

# --- ЮKassa (опционально) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:4000

# --- Telegram Support Bot ---
# Создать бота: @BotFather → /newbot
# Узнать свой Chat ID: @userinfobot → /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
