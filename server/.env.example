# ==================================
# SmartWord Server Configuration
# ==================================
# SECURITY: Generate secure values for all secrets!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/smartword

# --- Server ---
PORT=3000

# --- JWT Secrets (REQUIRED - min 32 characters each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- OpenRouter API Keys (comma-separated) ---
# Each key with $10+ credit gives 1,000 free requests/day
# Get keys: https://openrouter.ai/keys
OPENROUTER_API_KEYS=

# --- App Public URL ---
# For email links (verification, password reset)
APP_PUBLIC_URL=https://api.smartword.app

# --- SMTP Configuration (for sending emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@smartword.app

# --- Google OAuth (for Google Sign-In) ---
GOOGLE_CLIENT_ID=

# --- YooKassa (payment processing) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://api.smartword.app

# --- Telegram Support Bot ---
# Create bot: @BotFather → /newbot
# Get Chat ID: @userinfobot → /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- CORS Allowed Origins (comma-separated) ---
ALLOWED_ORIGINS=https://smartword.app,https://www.smartword.app
