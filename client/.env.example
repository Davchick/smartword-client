# URL бэкенда (порт из server/.env, по умолчанию 4000).
# На эмуляторе: http://localhost:4000
# На телефоне (Expo Go): укажите IP вашего ПК в локальной сети, например:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
# Узнать IP: Windows — ipconfig, macOS/Linux — ifconfig или ip addr
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth: Web client ID из Google Cloud Console (Credentials).
# Тот же ID используется на бэкенде как GOOGLE_CLIENT_ID.
# Вход через Google требует сборку приложения (npx expo run:android), Expo Go не поддерживается.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
